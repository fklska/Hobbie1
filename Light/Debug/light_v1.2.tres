code = "shader_type canvas_item;
render_mode blend_add;

uniform sampler2D cloudNoise2;



void light() {
// Input:5
	vec4 n_out5p0 = LIGHT_COLOR;
	float n_out5p4 = n_out5p0.a;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(cloudNoise2, UV);
	float n_out3p4 = n_out3p0.a;


// FloatOp:4
	float n_out4p0 = n_out5p4 * n_out3p4;


// Output:0
	LIGHT.rgb = vec3(n_out5p0.xyz);
	LIGHT.a = n_out4p0;


}
"
