code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec2 Vector2Parameter = vec2(-1.000000, 0.000000);
uniform sampler2D Noise : repeat_enable;



void fragment() {
// Input:21
	vec4 n_out21p0 = COLOR;
	float n_out21p4 = n_out21p0.a;


// Input:24
	float n_out24p0 = TIME;


// Vector2Parameter:23
	vec2 n_out23p0 = Vector2Parameter;


// VectorOp:25
	vec3 n_out25p0 = vec3(n_out24p0) * vec3(n_out23p0, 0.0);


// UVFunc:22
	vec2 n_in22p1 = vec2(1.00000, 1.00000);
	vec2 n_out22p0 = vec2(n_out25p0.xy) * n_in22p1 + UV;


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(Noise, n_out22p0);


// VectorOp:28
	vec4 n_out28p0 = n_out21p0 * n_out7p0;


// FloatOp:20
	float n_out20p0 = n_out7p0.x * n_out21p4;


// Output:0
	COLOR.rgb = vec3(n_out28p0.xyz);
	COLOR.a = n_out20p0;


}
"
