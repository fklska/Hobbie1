code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D Texture2DParameter : filter_nearest, repeat_enable;



void fragment() {
	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(TEXTURE, UV);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, UV);


// VectorOp:9
	vec4 n_out9p0 = n_out10p0 * n_out3p0;


// Output:0
	COLOR.rgb = vec3(n_out9p0.xyz);


}
