code = "shader_type canvas_item;
render_mode blend_mix;

uniform float FloatParameter = 0.0010000000475;
uniform sampler2D Texture2DParameter : filter_nearest, repeat_enable;



void fragment() {
	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(TEXTURE, UV);


// Input:6
	vec2 n_out6p0 = VERTEX;


// FloatParameter:7
	float n_out7p0 = FloatParameter;


// VectorOp:8
	vec2 n_out8p0 = n_out6p0 * vec2(n_out7p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out8p0);


// VectorOp:9
	vec4 n_out9p0 = n_out11p0 + n_out3p0;


// Output:0
	COLOR.rgb = vec3(n_out9p0.xyz);


}
"
